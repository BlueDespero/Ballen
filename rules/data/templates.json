{
	"not_on_zone": {
		"blanks": { "zone": ["edge"] },
		"tree": {
			"part": "count_at_most", "n": 0,
			"of": { "part": "in_zone", "zone": "$zone", "of": { "part": "target" } }
		}
	},
	"only_on_axis": {
		"blanks": { "axis": ["row"], "parity": ["even", "odd"] },
		"tree": {
			"part": "count_at_least", "n": 1,
			"of": { "part": "with_parity", "axis": "$axis", "parity": "$parity", "of": { "part": "target" } }
		}
	},
	"max_in_axis": {
		"blanks": { "axis": ["row"], "ball": ["same_colour"], "n": [] },
		"tree": {
			"part": "count_at_most", "n": "$n",
			"of": { "part": "$ball", "of": { "part": "same_axis", "axis": "$axis", "of": { "part": "target" } } }
		}
	},
	"no_line_of": {
		"blanks": { "n": [3] },
		"tree": {
			"part": "no_group_of", "n": "$n",
			"of": { "part": "lines_through", "of": { "part": "target" } }
		}
	},
	"not_next_to": {
		"blanks": { "ball": ["same_colour", "opponent_ball", "my_last_ball"] },
		"tree": {
			"part": "count_at_most", "n": 0,
			"of": { "part": "$ball", "of": { "part": "neighbours", "of": { "part": "target" } } }
		}
	},
	"colour_only_next_to": {
		"blanks": { "colour": ["yellow", "blue", "red", "green"], "other": ["yellow", "blue", "red", "green"] },
		"tree": {
			"part": "any",
			"of": [
				{ "part": "count_at_most", "n": 0,
					"of": { "part": "of_colour", "colour": "$colour", "of": { "part": "target" } } },
				{ "part": "count_at_most", "n": 0,
					"of": { "part": "of_colour", "colour": "$other", "of": { "part": "whole_board" } } },
				{ "part": "count_at_least", "n": 1,
					"of": { "part": "of_colour", "colour": "$other", "of": { "part": "neighbours", "of": { "part": "target" } } } }
			]
		}
	},
	"never_more_than": {
		"blanks": { "a": ["yellow", "blue", "red", "green"], "b": ["yellow", "blue", "red", "green"] },
		"tree": {
			"part": "any",
			"of": [
				{ "part": "count_at_most", "n": 0,
					"of": { "part": "of_colour", "colour": "$a", "of": { "part": "target" } } },
				{ "part": "no_more_than",
					"of": { "part": "of_colour", "colour": "$a", "of": { "part": "whole_board" } },
					"than": { "part": "of_colour", "colour": "$b", "of": { "part": "whole_board" } } }
			]
		}
	},
	"min_empty_neighbours": {
		"blanks": { "n": [1, 2, 3, 4, 5, 6, 7, 8] },
		"tree": {
			"part": "count_at_least", "n": "$n",
			"of": { "part": "empty", "of": { "part": "neighbours", "of": { "part": "target" } } }
		}
	},
	"not_same_axis_as": {
		"blanks": { "axis": ["row"], "ball": ["my_last_ball"] },
		"tree": {
			"part": "count_at_most", "n": 0,
			"of": { "part": "$ball", "of": { "part": "same_axis", "axis": "$axis", "of": { "part": "target" } } }
		}
	},
	"relative_to_last": {
		"blanks": { "direction": ["higher", "lower"] },
		"tree": {
			"part": "count_at_least", "n": 1,
			"of": { "part": "in_row_relative", "direction": "$direction",
				"than": { "part": "my_last_ball", "of": { "part": "whole_board" } }, "of": { "part": "target" } }
		}
	},
	"never_fill_axis": {
		"blanks": { "axis": ["row"] },
		"tree": {
			"part": "count_at_least", "n": 1,
			"of": { "part": "empty", "of": { "part": "same_axis", "axis": "$axis", "of": { "part": "target" } } }
		}
	},
	"zone_on_turn_parity": {
		"blanks": { "parity": ["even", "odd"], "zone": ["edge"] },
		"tree": {
			"part": "if_then",
			"if": { "part": "own_turn_parity", "parity": "$parity" },
			"then": { "part": "count_at_least", "n": 1,
				"of": { "part": "in_zone", "zone": "$zone", "of": { "part": "target" } } }
		}
	},
	"rows_for_first_turns": {
		"blanks": { "turns": [], "from": [1, 2, 3, 4, 5, 6], "to": [1, 2, 3, 4, 5, 6] },
		"tree": {
			"part": "if_then",
			"if": { "part": "own_turn_at_most", "n": "$turns" },
			"then": { "part": "count_at_least", "n": 1,
				"of": { "part": "in_rows", "from": "$from", "to": "$to", "of": { "part": "target" } } }
		}
	}
}
