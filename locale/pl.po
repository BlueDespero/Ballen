# Rules panel and guessing

msgid "AI's rules"
msgstr "Reguły komputera"

msgid "Your rules"
msgstr "Twoje reguły"

msgid "? = your private notes on the AI's rules"
msgstr "? = Twoje prywatne notatki o regułach komputera"

msgid "Rule out (your note)"
msgstr "Wykluczona (Twoja notatka)"

msgid "Suspect (your note)"
msgstr "Podejrzana (Twoja notatka)"

msgid "TRUE"
msgstr "PRAWDZIWA"

msgid "Guess"
msgstr "Wybierz"

msgid "Seal"
msgstr "Zatwierdź"

msgid "Confirm"
msgstr "Potwierdź"

msgid "The match is over. The AI's true rule is marked."
msgstr "Mecz się skończył. Prawdziwa reguła komputera jest zaznaczona."

msgid "The board is full. Both forced guesses are revealed together."
msgstr "Plansza jest pełna. Oba obowiązkowe typy zostaną odkryte jednocześnie."

msgid "You can guess at the start of your turn and until your colour pick."
msgstr "Możesz typować od początku swojej tury aż do wyboru koloru."

msgid "Select the rule you think is the AI's true rule."
msgstr "Zaznacz regułę, którą uważasz za prawdziwą regułę komputera."

msgid "Guess %s now, or Seal it as your forced guess."
msgstr "Wybierz %s teraz albo Zatwierdź jako obowiązkowy typ."

msgid "%s to make %s your forced guess. One right guess wins; else a draw."
msgstr "%s, aby ustawić %s jako obowiązkowy typ. Jeden trafny typ wygrywa, inaczej remis."

msgid "%s to name %s. Right wins, wrong loses."
msgstr "%s, aby wytypować %s. Trafny typ wygrywa, chybiony przegrywa."

msgid "Tap %s, then Confirm,"
msgstr "Stuknij %s, potem Potwierdź"

msgid "Hold %s"
msgstr "Przytrzymaj %s"

# Past turns

msgid "Live"
msgstr "Teraz"

msgid "Previous turn (Left arrow key)"
msgstr "Poprzednia tura (strzałka w lewo)"

msgid "Next turn (Right arrow key)"
msgstr "Następna tura (strzałka w prawo)"

# Rotate hint (a phone held upright)

msgid "Rotate your device"
msgstr "Obróć urządzenie"

msgid "Ballen plays in landscape."
msgstr "W Ballen gra się w poziomie."

msgid "Back to the live board"
msgstr "Powrót do bieżącej planszy"

msgid "Turn %d of %d: %s.\n\nA past board. Press Live, or play on, to return."
msgstr "Tura %d z %d: %s.\n\nTo dawna plansza. Naciśnij Teraz albo graj dalej, aby wrócić."

msgid "you placed %s"
msgstr "kładziesz kulę (%s)"

msgid "the AI placed %s"
msgstr "komputer kładzie kulę (%s)"

msgid "you had no legal cell for %s, so the ball was skipped"
msgstr "Twoja kula (%s) nie miała dozwolonego pola, więc została pominięta"

msgid "the AI had no legal cell for %s, so the ball was skipped"
msgstr "kula komputera (%s) nie miała dozwolonego pola, więc została pominięta"

# Match end

msgid "You win"
msgstr "Wygrywasz"

msgid "You lose"
msgstr "Przegrywasz"

msgid "Draw"
msgstr "Remis"

msgid "How the match ended."
msgstr "Jak skończył się mecz."

msgid "The AI's true rule"
msgstr "Prawdziwa reguła komputera"

msgid "Your true rule"
msgstr "Twoja prawdziwa reguła"

msgid "You skipped for the third time."
msgstr "Twoja kula zostaje pominięta po raz trzeci."

msgid "The AI skipped for the third time."
msgstr "Kula komputera zostaje pominięta po raz trzeci."

msgid "The board is full."
msgstr "Plansza jest pełna."

msgid "You named %s \"%s\", the AI's true rule."
msgstr "Typujesz %s „%s” – to prawdziwa reguła komputera."

msgid "You named %s \"%s\", but it isn't the AI's true rule."
msgstr "Typujesz %s „%s”, ale to nie jest prawdziwa reguła komputera."

msgid "The AI named %s \"%s\", your true rule."
msgstr "Komputer typuje %s „%s” – to Twoja prawdziwa reguła."

msgid "The AI named %s \"%s\", but it isn't your true rule."
msgstr "Komputer typuje %s „%s”, ale to nie jest Twoja prawdziwa reguła."

# Rules (rules/data/rules.json)

msgid "Never next to the same colour"
msgstr "Nigdy obok kuli tego samego koloru"

msgid "Red only next to blue"
msgstr "Czerwona tylko obok niebieskiej"

msgid "Only on even rows"
msgstr "Tylko w parzystych rzędach"

msgid "Never on the edge"
msgstr "Nigdy na brzegu"

msgid "At most 2 of a colour in any row"
msgstr "Najwyżej 2 kule jednego koloru w rzędzie"

msgid "Never more red than blue on the board"
msgstr "Nigdy więcej czerwonych niż niebieskich na planszy"

msgid "Never next to an opponent ball"
msgstr "Nigdy obok kuli przeciwnika"

msgid "Not next to the ball you placed last"
msgstr "Nie obok Twojej ostatniej kuli"

msgid "Never in the same row as your last ball"
msgstr "Nigdy w tym samym rzędzie co Twoja ostatnia kula"

msgid "Never complete a line of 3"
msgstr "Nigdy nie domykaj linii z 3 kul"

msgid "At least 2 cells from any red"
msgstr "Co najmniej 2 pola od każdej czerwonej"

msgid "Must touch an existing ball"
msgstr "Musi stykać się z kulą na planszy"

msgid "Must join your own group"
msgstr "Musi dołączyć do Twojej grupy"

msgid "Only in a row numbered higher than your last ball's row"
msgstr "Tylko w rzędzie o wyższym numerze niż rząd Twojej ostatniej kuli"

msgid "Only in a row numbered lower than your last ball's row"
msgstr "Tylko w rzędzie o niższym numerze niż rząd Twojej ostatniej kuli"

msgid "Must touch the next colour in yellow → blue → red → green"
msgstr "Musi stykać się z kolejnym kolorem w cyklu żółty → niebieski → czerwony → zielony"

msgid "Only cells with 2+ empty neighbours"
msgstr "Tylko pola z 2+ pustymi sąsiadami"

msgid "Never fill a row completely"
msgstr "Nigdy nie zapełniaj całego rzędu"

msgid "On your odd turns, edge only"
msgstr "W Twoich nieparzystych turach tylko brzeg"

msgid "For your first 5 turns, only rows 3 and 4"
msgstr "Przez pierwsze 5 Twoich tur tylko rzędy 3 i 4"

msgid "After any skip, must touch one of your own balls"
msgstr "Po każdym pominięciu musi stykać się z Twoją kulą"

msgid "Never next to the opponent's last ball"
msgstr "Nigdy obok ostatniej kuli przeciwnika"
